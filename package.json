{
    "name":  "kidguard-api",
    "version":  "1.0.0",
    "private":  true,
    "engines":  {
                    "node":  "\u003e=20"
                },
    "scripts":  {
                    "dev":  "tsx watch src/server.ts",
                    "build":  "tsc -p tsconfig.json",
                    "test":  "tsx --test tests/*.test.ts",
                    "start":  "node dist/server.js",
                    "prisma:generate":  "prisma generate",
                    "prisma:migrate:deploy":  "prisma migrate deploy",
                    "start:render":  "prisma migrate deploy \u0026\u0026 node dist/server.js",
                    "migrate:firestore":  "tsx scripts/migrate-firestore.ts",
                    "migrate:firebase-auth":  "tsx scripts/migrate-firebase-auth.ts",
                    "admin:bootstrap":  "tsx scripts/bootstrap-admin.ts"
                },
    "dependencies":  {
                         "@prisma/client":  "^6.19.0",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.7",
                         "express":  "^4.21.2",
                         "firebase-admin":  "^13.5.0",
                         "google-auth-library":  "^11.1.0",
                         "helmet":  "^8.1.0",
                         "zod":  "^3.24.2"
                     },
    "devDependencies":  {
                            "@types/cors":  "^2.8.17",
                            "@types/express":  "^5.0.0",
                            "@types/node":  "^22.13.10",
                            "prisma":  "^6.19.0",
                            "tsx":  "^4.19.3",
                            "typescript":  "^5.8.2"
                        }
}
