# Copy to .env on the server (never commit the real file). Generate secrets with:
#   openssl rand -base64 48

# Public hostname pointing (A/AAAA record) to the Hetzner server, e.g. api.kidguard.co.tz
# No domain yet? Use the free wildcard DNS name for your IP (HTTPS still works):
#   API_DOMAIN=46-62-239-174.sslip.io
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# PostgreSQL (internal only)
POSTGRES_DB=kidguard
POSTGRES_USER=kidguard
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM

# API secrets
AUTH_TOKEN_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_RANDOM
OTP_HASH_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_RANDOM
SESSION_TTL_DAYS=7
CORS_ORIGINS=https://kidguard-admin-site.vercel.app
GOOGLE_CLIENT_IDS=
SENDLIB_API_KEY=
SENDLIB_FROM_EMAIL="KidGuard <your-connected-gmail@gmail.com>"
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional tuning
API_RATE_LIMIT_PER_MINUTE=600
HEARTBEAT_RETENTION_DAYS=30

# AI assistant (start with: docker compose --profile ai up -d)
# Needs ~2 GB RAM on its own (Whisper + Piper). On a 2 GB server keep using the
# hosted AI service instead and set AI_ASSISTANT_HOST in docker-compose.yml.
AI_ASSISTANT_HOST=https://kidguard-ai-assistant.onrender.com
AI_ASSISTANT_SHARED_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
WHISPER_CPU_THREADS=2
