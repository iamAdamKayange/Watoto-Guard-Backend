# KidGuard production settings. deploy.sh fills this in for you and checks every key.
# Copy to .env on the server (never commit the real file). Generate secrets with:
#   openssl rand -hex 48
#
# [REQUIRED]  the API or AI will not start / work without it
# [FEATURE]   needed for one feature (shown in brackets); the rest still works
# [OPTIONAL]  sensible default

# ------------------------------------------------------------------ Web / HTTPS
# [REQUIRED] Public hostname of this server. No domain yet? Use <your-ip-with-dashes>.sslip.io
API_DOMAIN=api.example.com
# [REQUIRED] Email for the Let's Encrypt HTTPS certificate
ACME_EMAIL=admin@example.com
# [OPTIONAL] Browser origins allowed to call the API (admin website)
CORS_ORIGINS=https://kidguard-admin-site.vercel.app

# ------------------------------------------------------------------ Database
# [OPTIONAL] Leave empty to use the PostgreSQL container on this server.
#   Neon: paste the DIRECT connection string (host WITHOUT "-pooler"), keep sslmode=require.
DATABASE_URL=
# [REQUIRED] Password for the built-in PostgreSQL container (needed even when using Neon)
POSTGRES_DB=kidguard
POSTGRES_USER=kidguard
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM

# ------------------------------------------------------------------ API security
# [REQUIRED] Signs login sessions. Copy Render's value to keep users signed in.
AUTH_TOKEN_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_RANDOM
# [REQUIRED] Protects email verification codes (any random value)
OTP_HASH_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_RANDOM
# [OPTIONAL] Days a login stays valid
SESSION_TTL_DAYS=7

# ------------------------------------------------------------------ Email (Sendlib)
# [FEATURE: registration codes, password reset, school invitations]
SENDLIB_API_KEY=
SENDLIB_FROM_EMAIL="KidGuard <your-connected-gmail@gmail.com>"

# ------------------------------------------------------------------ Google sign-in
# [FEATURE: "Continue with Google"] OAuth client IDs, comma separated
GOOGLE_CLIENT_IDS=

# ------------------------------------------------------------------ Push notifications
# [FEATURE: push alerts to parents] Firebase service-account JSON on ONE line
FIREBASE_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------------ KidGuard AI
# AI runs on this server next to the API (private network, never exposed).
# [REQUIRED for AI] COMPOSE_PROFILES=ai starts the AI container
COMPOSE_PROFILES=ai
# [REQUIRED for AI] Where the API finds the AI. Same server: http://ai:8000
AI_ASSISTANT_HOST=http://ai:8000
# [REQUIRED for AI] Shared by API and AI (any random value, at least 32 characters)
AI_ASSISTANT_SHARED_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
# [REQUIRED for AI] Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# [OPTIONAL] AI model and speech settings
GEMINI_MODEL=gemini-3.5-flash-lite
# tiny = lightest, base = better Kiswahili (recommended), small = best but slow on CPU
WHISPER_MODEL=base
WHISPER_CPU_THREADS=2
# true on >= 4 GB RAM: faster voice replies (models stay in memory). false on 2 GB.
KEEP_MODELS_LOADED=false

# ------------------------------------------------------------------ Tuning
# [OPTIONAL]
API_RATE_LIMIT_PER_MINUTE=600
HEARTBEAT_RETENTION_DAYS=30
